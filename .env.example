# ── PRODUCTION ───────────────────────────────────────────────────
# Copy to .env.local — used by: npm run dev:prod
# Get from Supabase project settings → API

VITE_SUPABASE_URL=https://<prod-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<prod-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<prod-service-role-key>

# ── DEV / STAGING ─────────────────────────────────────────────────
# Copy to .env.dev.local — used by: npm run dev
# VITE_SUPABASE_URL=https://<dev-project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<dev-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<dev-service-role-key>

# ── E2E TESTS ────────────────────────────────────────────────────
# Copy to .env.test — used by Playwright
# TEST_EMAIL=admin@lilac.com
# TEST_PASSWORD=44rockersLilac
